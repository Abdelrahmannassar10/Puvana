                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/drivers/{{driverId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "drivers",
                "{{driverId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "Delete Driver",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/drivers/{{driverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "drivers",
                "{{driverId}}"
              ]
            }
          }
        }
      ]
    },
